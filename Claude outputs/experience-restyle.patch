+.project-modal__body[data-project="experience"] .project-modal__band-sub {
+    font-weight: 400;
+}
+
+.project-modal__body[data-project="experience"] .project-modal__band-date {
+    margin-left: auto;
+    color: #5a5a5a;
+    font-weight: 400;
+    white-space: nowrap;
+}
+
+@media (max-width: 600px) {
