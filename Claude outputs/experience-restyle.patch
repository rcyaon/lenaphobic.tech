+/* ── TERMINAL.EXE ─────────────────────────────────────────────────────────
+   Job headings: company in bold, role in regular weight, dates set apart in
+   grey on the right, so a narrow window never breaks the line mid-date. */
+.project-modal__body[data-project="experience"] .project-modal__experience-panel .project-modal__panel-heading--band {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: baseline;
+    column-gap: 2ch;
+}
